# Postgres connection string.
# Local:    postgres://postgres:postgres@localhost:5432/ledger
# Supabase: Project Settings -> Database -> Connection string (URI). Use the
#           "Session pooler" URI if your network has no IPv6.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger

# Separate database used by `npm test` (it is wiped between tests).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger_test

# Set to true for hosted Postgres that requires SSL (Supabase, RDS).
DATABASE_SSL=false

PORT=3000

# Comma-separated list of origins allowed to call the API from a browser,
# or * for any (fine for this assignment).
CORS_ORIGIN=*
