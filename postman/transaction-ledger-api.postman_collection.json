    {
      "name": "3. History",
      "item": [
        {
          "name": "All transactions (newest first)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountA}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountA}}",
                "transactions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('4 transactions, rejected ones not saved', () => pm.expect(body.pagination.total_records).to.eql(4));",
                  "pm.test('newest first', () => { const t = body.data.map(x => Date.parse(x.created_at)); pm.expect(t).to.eql([...t].sort((a, b) => b - a)); });",
                  "pm.test('pagination fields', () => pm.expect(body.pagination).to.have.keys('current_page', 'page_size', 'total_records', 'total_pages'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Only credits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountA}}/transactions?type=credit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountA}}",
                "transactions"
